{
  "name": "@cosyte/mllp",
  "version": "0.1.12",
  "description": "MLLP transport for HL7 v2 in Node.js and TypeScript: client and server, framing, ACK correlation, auto-reconnect, TLS, and an in-memory transport for tests.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "overrides": {
      "brace-expansion@>=4.0.0 <5.0.12": "5.0.12",
      "esbuild@>=0.27.3 <0.28.2": "0.28.2",
      "js-yaml@>=3.0.0 <3.15.2": "3.15.2",
      "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
      "minimatch@>=7.0.0 <11.0.1": "11.0.1",
      "typedoc>minimatch": "10.2.6"
    }
  },
  "license": "MIT",
  "author": "Cosyte <hello@cosyte.com> (https://cosyte.com)",
  "homepage": "https://docs.cosyte.com/mllp",
  "bugs": {
    "url": "https://github.com/cosyte/mllp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cosyte/mllp.git"
  },
  "keywords": [
    "hl7",
    "hl7v2",
    "mllp",
    "mllps",
    "healthcare",
    "interoperability",
    "tcp",
    "tls",
    "typescript",
    "client",
    "server"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "TRADEMARKS.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing/index.d.ts",
        "default": "./dist/testing/index.mjs"
      },
      "require": {
        "types": "./dist/testing/index.d.cts",
        "default": "./dist/testing/index.cjs"
      }
    },
    "./ack-from-hl7": {
      "import": {
        "types": "./dist/ack-from-hl7/index.d.ts",
        "default": "./dist/ack-from-hl7/index.mjs"
      },
      "require": {
        "types": "./dist/ack-from-hl7/index.d.cts",
        "default": "./dist/ack-from-hl7/index.cjs"
      }
    },
    "./arbitraries": {
      "import": {
        "types": "./dist/arbitraries/index.d.ts",
        "default": "./dist/arbitraries/index.mjs"
      },
      "require": {
        "types": "./dist/arbitraries/index.d.cts",
        "default": "./dist/arbitraries/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "prettier": "@cosyte/prettier-config",
  "peerDependencies": {
    "@cosyte/hl7": ">=0.0.0",
    "fast-check": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@cosyte/hl7": {
      "optional": true
    },
    "fast-check": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/cli": "2.31.0",
    "@cosyte/bench": "^0.1.1",
    "@cosyte/eslint-config": "^0.1.4",
    "@cosyte/hl7": "^0.1.0",
    "@cosyte/prettier-config": "^0.1",
    "@cosyte/process": "^0.1.8",
    "@cosyte/script-utils": "^0.1.10",
    "@cosyte/test-utils": "^0.1.4",
    "@cosyte/tsconfig": "^0.1",
    "@cosyte/tsup-config": "^0.1.3",
    "@cosyte/vitest-config": "^0.1.6",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/node": "^22.0.0",
    "@types/node-forge": "1.3.14",
    "fast-check": "4.10.2",
    "node-forge": "1.4.3",
    "selfsigned": "2.4.1",
    "simple-git-hooks": "2.14.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "scripts": {
    "build": "cosyte-process build",
    "changeset": "changeset",
    "typecheck": "cosyte-process typecheck",
    "phi-scan": "tsx scripts/phi-scan.ts",
    "check:catalog": "cosyte-catalog",
    "check:claude-card": "cosyte-claude-card",
    "check:docs-reference": "cosyte-docs-reference --check",
    "check:documents": "pnpm check:readme && pnpm check:claude-card && pnpm check:catalog && pnpm check:docs-reference",
    "check:no-emdash": "cosyte-no-emdash",
    "check:no-internal-refs": "cosyte-internal-refs",
    "check:process": "cosyte-process check",
    "check:readme": "cosyte-readme",
    "lint": "cosyte-process lint",
    "lint:fix": "cosyte-process lint --fix",
    "format": "cosyte-process format",
    "format:check": "cosyte-process format --check",
    "test": "cosyte-process test",
    "test:watch": "cosyte-process test --watch",
    "test:coverage": "cosyte-process test --coverage",
    "test:perf": "vitest run --config vitest.perf.config.ts",
    "test:property": "vitest run test/property",
    "quality:check": "cosyte-ratchet check --skip mutation",
    "quality:mutation": "cosyte-ratchet check --skip coverage",
    "quality:raise": "cosyte-ratchet raise",
    "mutate": "cosyte-mutate",
    "mutate:full": "cosyte-mutate full",
    "fuzz": "vitest run test/property/fuzz.property.test.ts test/property/transport-fuzz.property.test.ts test/property/ack-fuzz.property.test.ts",
    "examples": "tsx scripts/run-examples.ts",
    "bench:reading": "cosyte-bench run --suite bench/mllp.bench.mjs --target dist/index.mjs",
    "bench:compare": "cosyte-bench compare --suite bench/mllp.bench.mjs",
    "bench:profile": "node bench/profile.mjs",
    "bench:socket": "node --expose-gc bench/socket.mjs",
    "bench:open-loop": "node bench/open-loop.mjs",
    "certs:gen": "node scripts/generate-test-certs.mjs",
    "clean": "rm -rf dist coverage",
    "docs:reference": "cosyte-docs-reference",
    "attw": "cosyte-attw",
    "pack:docs": "cosyte-process pack-docs",
    "version": "changeset version && node scripts/sync-version.mjs && cosyte-docs-reference && cosyte-process format",
    "publish:dry": "pnpm publish --dry-run --no-git-checks",
    "release": "changeset publish",
    "prepublishOnly": "pnpm clean && pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm attw",
    "prepare": "command -v simple-git-hooks >/dev/null 2>&1 && simple-git-hooks 1>&2 || true"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm phi-scan --staged"
  }
}
