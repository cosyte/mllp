{
  "name": "@cosyte/mllp",
  "version": "0.1.3",
  "description": "MLLP transport for HL7 v2 in Node.js and TypeScript: client and server, framing, ACK correlation, auto-reconnect, TLS, and an in-memory transport for tests.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "overrides": {
      "brace-expansion@>=4.0.0 <5.0.12": "5.0.12",
      "esbuild@>=0.27.3 <0.28.1": "0.28.1",
      "js-yaml@>=3.0.0 <3.15.2": "3.15.2",
      "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
      "minimatch@>=7.0.0 <11.0.1": "11.0.1"
    }
  },
  "license": "MIT",
  "author": "Cosyte <hello@cosyte.com> (https://cosyte.com)",
  "homepage": "https://docs.cosyte.com/mllp",
  "bugs": {
    "url": "https://github.com/cosyte/mllp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cosyte/mllp.git"
  },
  "keywords": [
    "hl7",
    "hl7v2",
    "mllp",
    "mllps",
    "healthcare",
    "interoperability",
    "tcp",
    "tls",
    "typescript"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "TRADEMARKS.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing/index.d.ts",
        "default": "./dist/testing/index.mjs"
      },
      "require": {
        "types": "./dist/testing/index.d.cts",
        "default": "./dist/testing/index.cjs"
      }
    },
    "./ack-from-hl7": {
      "import": {
        "types": "./dist/ack-from-hl7/index.d.ts",
        "default": "./dist/ack-from-hl7/index.mjs"
      },
      "require": {
        "types": "./dist/ack-from-hl7/index.d.cts",
        "default": "./dist/ack-from-hl7/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "prettier": "@cosyte/prettier-config",
  "peerDependencies": {
    "@cosyte/hl7": ">=0.0.0"
  },
  "peerDependenciesMeta": {
    "@cosyte/hl7": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.4",
    "@changesets/cli": "2.31.0",
    "@cosyte/eslint-config": "^0.1",
    "@cosyte/hl7": "^0.1.0",
    "@cosyte/prettier-config": "^0.1",
    "@cosyte/script-utils": "^0.1.5",
    "@cosyte/test-utils": "^0.1",
    "@cosyte/tsconfig": "^0.1",
    "@cosyte/tsup-config": "^0.1",
    "@cosyte/vitest-config": "^0.1",
    "@types/node": "^22.0.0",
    "@types/node-forge": "1.3.14",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "10.5.0",
    "fast-check": "3.23.2",
    "node-forge": "1.4.1",
    "prettier": "3.8.3",
    "selfsigned": "2.4.1",
    "simple-git-hooks": "2.13.0",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  },
  "scripts": {
    "build": "tsup",
    "changeset": "changeset",
    "typecheck": "tsc --noEmit && tsc --noEmit -p examples",
    "phi-scan": "tsx scripts/phi-scan.ts",
    "check:catalog": "cosyte-catalog",
    "check:claude-card": "cosyte-claude-card",
    "check:documents": "pnpm check:readme && pnpm check:claude-card && pnpm check:catalog",
    "check:no-emdash": "cosyte-no-emdash",
    "check:no-internal-refs": "cosyte-internal-refs",
    "check:readme": "cosyte-readme",
    "lint": "eslint \"src/**/*.ts\" \"scripts/**/*.ts\" \"test/**/*.ts\" \"examples/**/*.ts\" --max-warnings=0 --no-error-on-unmatched-pattern",
    "lint:fix": "eslint \"src/**/*.ts\" \"scripts/**/*.ts\" \"test/**/*.ts\" \"examples/**/*.ts\" --fix --no-error-on-unmatched-pattern",
    "format": "prettier --write \"src/**/*.{ts,md}\" \"test/**/*.ts\" \"scripts/**/*.{ts,mjs}\" \"examples/**/*.{ts,json}\" \"docs-content/**/*.{md,json}\" \"*.{json,md,yml}\"",
    "format:check": "prettier --check \"src/**/*.{ts,md}\" \"test/**/*.ts\" \"scripts/**/*.{ts,mjs}\" \"examples/**/*.{ts,json}\" \"docs-content/**/*.{md,json}\" \"*.{json,md,yml}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "examples": "tsx scripts/run-examples.ts",
    "certs:gen": "node scripts/generate-test-certs.mjs",
    "clean": "rm -rf dist coverage",
    "attw": "cosyte-attw",
    "pack:docs": "bash scripts/build-docs-artifacts.sh",
    "version": "changeset version && node scripts/sync-version.mjs && prettier --write package.json src/index.ts",
    "publish:dry": "pnpm publish --dry-run --no-git-checks",
    "release": "changeset publish",
    "prepublishOnly": "pnpm clean && pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm attw",
    "prepare": "command -v simple-git-hooks >/dev/null 2>&1 && simple-git-hooks 1>&2 || true"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm phi-scan --staged"
  }
}
